<%- include('partials/header', { title: 'Books' }) %>

<section class="card">
  <div class="card-head">
    <h2>Books</h2>
    <a class="btn" href="/books/new">+ Add book</a>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Cover</th><th>book_id</th><th>title</th><th>price</th><th>author_id</th><th></th></tr></thead>
      <tbody>
      <% books.forEach(b => { %>
        <tr>
          <td><%- include('partials/thumb', { src: b.cover, label: b.title, round: false }) %></td>
          <td><%= b.book_id %></td>
          <td><%= b.title %></td>
          <td><%= Number(b.price).toFixed(2) %></td>
          <td><%= b.author_id %> <small class="muted"><%= names[b.author_id] || '' %></small></td>
          <td><div class="actions">
            <a class="btn btn-sm btn-ghost" href="/books/<%= b.book_id %>/edit">Edit</a>
            <form method="post" action="/books/<%= b.book_id %>/delete"
                  onsubmit="return confirm('Remove book &quot;<%= b.title.replace(/'/g, '') %>&quot;?')">
              <button class="btn btn-sm btn-danger">Remove</button>
            </form>
          </div></td>
        </tr>
      <% }) %>
      <% if (!books.length) { %><tr><td colspan="6" class="empty">No books yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
