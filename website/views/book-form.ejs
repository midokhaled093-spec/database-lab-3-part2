<%- include('partials/header', { title: book ? 'Edit book' : 'Add book' }) %>

<section class="card form-card">
  <h2><%= book ? `Edit book #${book.book_id}` : 'Add a book' %></h2>
  <% if (!authors.length) { %>
    <p class="alert alert-err">Add an author first — every book needs an author.</p>
  <% } %>
  <form method="post" enctype="multipart/form-data"
        action="<%= book ? `/books/${book.book_id}/edit` : '/books/new' %>">
    <label>Title
      <input name="title" required maxlength="150" value="<%= book ? book.title : '' %>">
    </label>
    <label>Price
      <input name="price" type="number" step="0.01" min="0" required value="<%= book ? book.price : '' %>">
    </label>
    <label>Author
      <select name="author_id" required>
        <option value="" disabled <%= book ? '' : 'selected' %>>Choose an author…</option>
        <% authors.forEach(a => { %>
          <option value="<%= a.author_id %>" <%= book && book.author_id === a.author_id ? 'selected' : '' %>>
            <%= a.author_id %> — <%= a.name %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>Cover image <small class="muted">(optional, max 5 MB)</small>
      <input name="cover" type="file" accept="image/*">
    </label>
    <% if (book && book.cover) { %>
      <div class="current-img">
        <img class="thumb" src="<%= book.cover %>" alt="current cover">
        <label class="inline"><input type="checkbox" name="remove_cover" value="1"> Remove current cover</label>
      </div>
    <% } %>
    <div class="form-actions">
      <button class="btn"><%= book ? 'Save changes' : 'Add book' %></button>
      <a class="btn btn-ghost" href="/books">Cancel</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
